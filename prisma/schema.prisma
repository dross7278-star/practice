// Booking requests submitted from the public site.
// The datasource URL is supplied by prisma.config.ts (Prisma 7 config-driven datasource).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  NEW
  CONFIRMED
  DECLINED
}

model BookingRequest {
  id        String        @id @default(cuid())
  serviceId String
  name      String
  email     String
  phone     String?
  startsAt  DateTime
  endsAt    DateTime
  notes     String?
  status    RequestStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Database-level guard against two people requesting the same slot.
  @@unique([serviceId, startsAt])
  @@index([startsAt])
}
